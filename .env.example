# URL publique du site — sert aux métadonnées, au sitemap et aux cartes Open Graph.
# En local, laissez vide : http://localhost:3000 est utilisé par défaut sur Vercel Preview.
NEXT_PUBLIC_SITE_URL=https://hashory.app

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=your-team:your-deployment-name
CLERK_JWT_ISSUER_DOMAIN=your-clerk-subdomain.clerk.accounts.dev

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

ORACLY_ENCRYPTION_KEY=your_32_char_random_encryption_key

CMC_API_KEY=your_coinmarketcap_api_key

# Serveur MCP (/api/mcp) : secret partagé avec Convex, à définir aussi via
# `npx convex env set MCP_SERVER_SECRET ...`. Générez-le avec `openssl rand -hex 32`.
MCP_SERVER_SECRET=your_random_mcp_secret
